{
  "name": "eclipse-code",
  "version": "0.1.23",
  "private": true,
  "productName": "Eclipse Code",
  "desktopName": "eclipse-code.desktop",
  "description": "Tarefas, Líder e subtarefas para Claude Code e Codex, sem canvas.",
  "main": "./out/main/index.js",
  "author": {
    "name": "vings"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b tsconfig.node.json tsconfig.web.json",
    "test": "node scripts/vitest-electron.mjs run",
    "test:watch": "node scripts/vitest-electron.mjs",
    "lint": "eslint .",
    "screenshots": "electron-vite build && electron scripts/screenshots.mjs --ozone-platform=headless --no-sandbox",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rebuild:native": "electron-builder install-app-deps",
    "verify:native": "node scripts/verify-native.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:linux": "electron-vite build && electron-builder --linux AppImage",
    "build:win": "node scripts/build-win.mjs"
  },
  "build": {
    "appId": "app.eclipsecode.next",
    "productName": "Eclipse Code",
    "executableName": "eclipse-code",
    "artifactName": "Eclipse-Code-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out{,/**/*}",
      "package.json",
      "!release{,/**/*}",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*{,/**/*}",
      "!node_modules/@openai/codex-*{,/**/*}",
      "!node_modules/{react,react-dom,scheduler,@xterm}{,/**/*}",
      "!node_modules/better-sqlite3/{deps,src}{,/**/*}",
      "!node_modules/node-pty/{deps,src,scripts}{,/**/*}",
      "!node_modules/node-pty/prebuilds/darwin-*{,/**/*}",
      "!node_modules/**/*.{map,md,ts,tsx}"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/better-sqlite3/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "synopsis": "Tarefas, Líder e subtarefas para Claude Code e Codex",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "files": [
        "!node_modules/node-pty/prebuilds/win32-*{,/**/*}"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Onlybielzin",
        "repo": "eclipse-code"
      }
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "CHANGELOG.md",
        "to": "CHANGELOG.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "files": [
        "!node_modules/node-pty/build{,/**/*}",
        "!node_modules/node-pty/prebuilds/win32-arm64{,/**/*}"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "Eclipse Code"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.73.0",
    "@agentclientprotocol/codex-acp": "1.6.2",
    "@agentclientprotocol/sdk": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@testing-library/dom": "10",
    "@testing-library/react": "16",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.5.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^16",
    "jsdom": "26",
    "prettier": "^3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8",
    "vite": "^6.0.3",
    "vitest": "^4.1.0"
  },
  "repository": "github:Onlybielzin/eclipse-code"
}
