{
  "name": "eclipse-code-next",
  "version": "0.1.0",
  "private": true,
  "productName": "Eclipse Code",
  "desktopName": "eclipse-code-next.desktop",
  "description": "Tarefas, Líder e subtarefas para Claude Code e Codex, sem canvas.",
  "main": "./out/main/index.js",
  "author": {
    "name": "vings"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b tsconfig.node.json tsconfig.web.json",
    "test": "node scripts/vitest-electron.mjs run",
    "test:watch": "node scripts/vitest-electron.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rebuild:native": "electron-builder install-app-deps",
    "verify:native": "node scripts/verify-native.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:linux": "electron-vite build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "app.eclipsecode.next",
    "productName": "Eclipse Code",
    "executableName": "eclipse-code-next",
    "artifactName": "Eclipse-Code-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out{,/**/*}",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/better-sqlite3/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "synopsis": "Tarefas, Líder e subtarefas para Claude Code e Codex",
      "syncDesktopName": true
    },
    "publish": null
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.73.0",
    "@agentclientprotocol/codex-acp": "1.6.2",
    "@agentclientprotocol/sdk": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "^12.11.1",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.5.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^16",
    "prettier": "^3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8",
    "vite": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
